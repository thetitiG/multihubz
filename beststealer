-- UTILITY FUNCTIONS
-- ============================================================
 
local function makeDraggable(frame, handle)
    local dragging, dragStart, startPos
    handle = handle or frame
    handle.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = i.Position
            startPos = frame.Position
        end
    end)
    handle.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UIS.InputChanged:Connect(function(i)
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            local d = i.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset+d.X, startPos.Y.Scale, startPos.Y.Offset+d.Y)
        end
    end)
end
 
local function corner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 6)
    c.Parent = parent
    return c
end
 
local function stroke(parent, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color or Color3.fromRGB(50,50,80)
    s.Thickness = thickness or 1
    s.Parent = parent
    return s
end
 
local function label(parent, text, size, color, font, xalign)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextSize = size or 14
    l.TextColor3 = color or Color3.fromRGB(220,220,220)
    l.Font = font or Enum.Font.GothamBold
    l.TextXAlignment = xalign or Enum.TextXAlignment.Left
    l.Parent = parent
    return l
end
 
local function makeToggle(parent, pos, default, onToggle)
    local togBg = Instance.new("Frame")
    togBg.Size = UDim2.new(0, 44, 0, 22)
    togBg.Position = pos
    togBg.BackgroundColor3 = default and Color3.fromRGB(40,200,80) or Color3.fromRGB(55,55,75)
    togBg.BorderSizePixel = 0
    togBg.Parent = parent
    corner(togBg, 11)
 
    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 18, 0, 18)
    knob.Position = default and UDim2.new(0, 24, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
    knob.BackgroundColor3 = Color3.fromRGB(255,255,255)
    knob.BorderSizePixel = 0
    knob.Parent = togBg
    corner(knob, 9)
 
    local state = default or false
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1,0,1,0)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.Parent = togBg
 
    btn.MouseButton1Click:Connect(function()
        state = not state
        local goal = state and {
            BackgroundColor3 = Color3.fromRGB(40,200,80)
        } or {
            BackgroundColor3 = Color3.fromRGB(55,55,75)
        }
        TweenService:Create(togBg, TweenInfo.new(0.15), goal):Play()
        TweenService:Create(knob, TweenInfo.new(0.15), {
            Position = state and UDim2.new(0,24,0.5,-9) or UDim2.new(0,2,0.5,-9)
        }):Play()
        if onToggle then onToggle(state) end
    end)
 
    return togBg
end
 
local function makeButton(parent, text, bgColor, textColor, size, pos)
    local btn = Instance.new("TextButton")
    btn.Size = size or UDim2.new(0, 80, 0, 28)
    btn.Position = pos or UDim2.new(0,0,0,0)
    btn.BackgroundColor3 = bgColor or Color3.fromRGB(30,120,200)
    btn.BorderSizePixel = 0
    btn.Text = text
    btn.TextColor3 = textColor or Color3.fromRGB(255,255,255)
    btn.TextSize = 13
    btn.Font = Enum.Font.GothamBold
    btn.Parent = parent
    corner(btn, 6)
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = bgColor and Color3.new(bgColor.R+0.05, bgColor.G+0.05, bgColor.B+0.05) or Color3.fromRGB(50,140,220)}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = bgColor or Color3.fromRGB(30,120,200)}):Play()
    end)
    return btn
end
 
local function makeRow(parent, yOffset, labelText, isToggle, default, onToggle)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -16, 0, 36)
    row.Position = UDim2.new(0, 8, 0, yOffset)
    row.BackgroundColor3 = Color3.fromRGB(20, 20, 38)
    row.BorderSizePixel = 0
    row.Parent = parent
    corner(row, 6)
 
    local lbl = label(row, labelText, 13, Color3.fromRGB(200,195,230), Enum.Font.Gotham)
    lbl.Size = UDim2.new(1, -60, 1, 0)
    lbl.Position = UDim2.new(0, 10, 0, 0)
 
    if isToggle then
        makeToggle(row, UDim2.new(1, -50, 0.5, -11), default or false, onToggle)
    end
    return row
end
 
